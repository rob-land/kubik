#!@PYTHON@
# -*- coding: utf-8 -*-
# Kubik launcher — generated by meson, do not edit.

import os
import sys
import signal

signal.signal(signal.SIGINT, signal.SIG_DFL)

pkgdatadir = '@PKGDATADIR@'

# Make the installed package importable when the prefix is not one Python
# already searches (a --prefix=$HOME/.local build, say). Harmless otherwise.
sys.path.insert(1, os.path.dirname('@MODULEDIR@'))

import gi
gi.require_version('Gtk', '4.0')
gi.require_version('Adw', '1')
from gi.repository import Gio

resource_path = os.path.join(pkgdatadir, '@APP_ID@.gresource')
Gio.Resource.load(resource_path)._register()

from kubik import main
sys.exit(main.main())
